{
  "name": "unb-libraries/update-notifier",
  "description": "Checks servers for available apt updates and reports them to Amazon SNS",
  "require": {
    "php": "^8.4",
    "aws/aws-sdk-php": "~3.394.0",
    "consolidation/robo": "^5"
  },
  "autoload": {
    "psr-4": {
      "UNBLibraries\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UNBLibraries\\Tests\\UpdateNotifier\\": "tests/"
    }
  },
  "bin": [
    "bin/update-notifier"
  ],
  "authors": [
    {
      "name": "UNB Libraries",
      "email": "libsupport@unb.ca"
    }
  ],
  "config": {
    "platform": {
      "php": "8.4.1"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "squizlabs/php_codesniffer": "^3",
    "phpunit/phpunit": "^12"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "fix": "phpcbf",
    "analyse": "phpstan analyse",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the PHPUnit test suite",
    "lint": "Check coding standards (PSR-12, phpcs.xml)",
    "fix": "Fix coding standard violations that phpcbf can fix automatically",
    "analyse": "Run PHPStan static analysis (phpstan.neon)",
    "check": "Run lint, analyse and test; stops at the first failure"
  }
}
