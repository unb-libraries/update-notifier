{
  "name": "unb-libraries/update-notifier",
  "description": "Checks servers for available apt updates and reports them to Amazon SNS",
  "require": {
    "php": "^8.1",
    "aws/aws-sdk-php": "^3.47",
    "consolidation/robo": "^5",
    "cweagans/composer-patches": "~1.0"
  },
  "autoload": {
    "psr-4": {
      "UNBLibraries\\": "src/"
    }
  },
  "bin": [
    "bin/update-notifier"
  ],
  "authors": [
    {
      "name": "UNB Libraries",
      "email": "libsupport@unb.ca"
    }
  ],
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "extra": {
    "patches": {
      "consolidation/robo": {
        "Symfony Console 7.4 compatibility": "https://patch-diff.githubusercontent.com/raw/consolidation/robo/pull/1185.diff"
      }
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^1",
    "squizlabs/php_codesniffer": "^3"
  }
}
