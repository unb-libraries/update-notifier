{
  "name": "unb-libraries/update-notifier",
  "description": "Checks servers for available apt updates and reports them to Amazon SNS",
  "require": {
    "php": "^8.1",
    "aws/aws-sdk-php": "~3.394.0",
    "consolidation/robo": "^5"
  },
  "autoload": {
    "psr-4": {
      "UNBLibraries\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UNBLibraries\\Tests\\UpdateNotifier\\": "tests/"
    }
  },
  "bin": [
    "bin/update-notifier"
  ],
  "authors": [
    {
      "name": "UNB Libraries",
      "email": "libsupport@unb.ca"
    }
  ],
  "require-dev": {
    "phpstan/phpstan": "^1",
    "squizlabs/php_codesniffer": "^3",
    "phpunit/phpunit": "^12"
  },
  "scripts": {
    "test": "phpunit"
  }
}
